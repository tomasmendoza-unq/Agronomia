{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023"],
        "types": ["node"],
        "skipLibCheck": true,

        /* Bundler mode */
        "module": "nodenext",
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["vite.config.ts"]
}
